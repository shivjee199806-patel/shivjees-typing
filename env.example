PORT=3000
JWT_SECRET=change-this-in-production
ADMIN_EMAIL=admin@shivjeestyping.com
ADMIN_PASSWORD=Admin@12345

# Mobile OTP login
# For local testing only: returns OTP in the login screen and terminal. Set 0 in production.
DEV_OTP_MODE=1
# Production: connect your SMS provider through a webhook accepting JSON {mobile, otp, message}.
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=
ADMIN_SIGNUP_CODE=ChangeThisPrivateAdminCode2026!

# Optional: point this to a persistent disk/folder on hosting.
# Example Linux: DATA_DIR=/var/data/shivjees
DATA_DIR=
